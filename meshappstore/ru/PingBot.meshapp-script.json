  "name": "PingBot",
  "description": "PingBot для канала Ping/Pg==🤖",
  "author": "MeshApp",
  "codeLines": [
    "local function hhmm_utc_plus_3()",
    "    local now = mesh.now() + 3 * 3600",
    "    local hh = math.floor((now % 86400) / 3600)",
    "    local mm = math.floor((now % 3600) / 60)",
    "    return string.format(\"%02d:%02d\", hh, mm)",
    "end",
    "",
    "math.randomseed(math.floor(mesh.now() * 1000) % 2147483647)",
    "",
    "-- Получение id канала по его имени",
    "function channel_index_by_name(name)",
    "      if name == nil or name == \"\" then",
    "          return nil",
    "      end",
    "",
    "      local target = string.lower(name)",
    "",
    "      for _, channel in ipairs(mesh.chat.channels()) do",
    "          if channel.name ~= nil and string.lower(channel.name) == target then",
    "              return channel.index",
    "          end",
    "      end",
    "",
    "      return nil",
    "end",
    "",
    "function on_message(msg)",
    "    if msg.outgoing or msg.chat_type ~= \"channel\" then",
    "        return",
    "    end",
    "",
    "    if string.lower(tostring(msg.channel_name or \"\")) ~= \"ping\" then",
    "        return",
    "    end",
    "",
    "    local text = string.lower(tostring(msg.text or \"\"))",
    "    text = string.gsub(text, \"^%s+\", \"\")",
    "    text = string.gsub(text, \"%s+$\", \"\")",
    "",
    "    if text ~= \"ping\" and text ~= \"test\" and text ~= \"пинг\" then",
    "        return",
    "    end",
    "        ",
    "    local hops = msg.hops",
    "    mesh.sleep(math.random(1, 5))",
    "    ",
    "    if hops == 0 then",
    "        mesh.chat.reply(",
    "            msg,",
    "            \"🤖 MeshAppBot SNR \" .. tostring(msg.rx_snr) .. \" / \" .. \"RSSI \" .. tostring(msg.rx_rssi) .. \" в \" .. hhmm_utc_plus_3()",
    "        )",
    "    else",
    "        mesh.chat.reply(",
    "            msg,",
    "            \"🤖 MeshAppBot 🐇 \" .. tostring(hops or \"unknown\") .. \" в \" .. hhmm_utc_plus_3()",
    "        )        ",
    "    end",
    " end"
  ],
  "botType": "AIR_BOT",
  "automationName": ""
}
