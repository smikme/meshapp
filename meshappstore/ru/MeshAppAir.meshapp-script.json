{
  "format": "meshapp-lua-script",
  "version": 1,
  "scriptVersion": 8,
  "guid": "902f714a-8067-4b31-8cc9-435a7f5e448e",
  "icon": "📡",
  "name": "MeshAppAir",
  "description": "Радио ping-бот с оценкой качества линка, памятью по нодам и командами @MeshAppAir stats/top",
  "author": "MeshApp",
  "codeLines": [
    "--[[",
    "MeshAppAir",
    "==========",
    "",
    "Это пример AIR_BOT-скрипта для MeshApp. Он показывает несколько практических",
    "приёмов, которые удобно использовать в собственных Lua-ботах:",
    "",
    "1. Как слушать входящие сообщения через on_message(msg).",
    "2. Как отвечать по радио в тот же чат через mesh.chat.reply(msg, text).",
    "3. Как фильтровать нужный канал и нужные команды.",
    "4. Как хранить состояние между запусками через mesh.kv.",
    "5. Как считать простую статистику по каждой ноде.",
    "6. Как защищаться от эхо собственного сообщения.",
    "7. Как не дать ошибке в callback остановить бота.",
    "",
    "Как пользоваться:",
    "- отправьте ping/test/пинг в канал Ping или в DM боту;",
    "- отправьте @MeshAppAir stats, чтобы получить статистику своей ноды;",
    "- отправьте @MeshAppAir top, чтобы получить топ линков по накопленным данным.",
    "",
    "Важно для Meshtastic:",
    "- радио-пакеты имеют ограниченный размер, поэтому ответы короткие;",
    "- stats/top читают накопленную статистику, но сами не увеличивают счётчик n;",
    "- обновление статистики происходит только на реальные ping/test/пинг.",
    "]]",
    "",
    "-- Настройки бота. Их удобно держать в начале файла, чтобы пользователь мог",
    "-- быстро адаптировать скрипт под свою сеть без чтения всей логики.",
    "local BOT_NAME = \"MeshAppAir\"",
    "local SHORT_NAME = \"Air\"",
    "local HANDLE = \"@meshappair\"",
    "local PING_CHANNEL = \"ping\"",
    "local KV_PREFIX = \"node:\"",
    "local TOP_LIMIT = 3",
    "",
    "-- Lua math.random без seed будет повторять одну и ту же последовательность.",
    "-- Небольшая случайная задержка нужна, чтобы несколько ping-ботов не отвечали",
    "-- в эфир одновременно.",
    "math.randomseed(math.floor(mesh.now() * 1000) % 2147483647)",
    "",
    "-- Строковые помощники ниже делают входные данные безопаснее:",
    "-- nil превращается в пустую строку, пробелы обрезаются, а регистр приводится",
    "-- к нижнему для сравнения команд и имени канала.",
    "local function trim(value)",
    "    local text = tostring(value or \"\")",
    "    text = string.gsub(text, \"^%s+\", \"\")",
    "    text = string.gsub(text, \"%s+$\", \"\")",
    "    return text",
    "end",
    "",
    "local function lower_trim(value)",
    "    return string.lower(trim(value))",
    "end",
    "",
    "local function is_blank(value)",
    "    return value == nil or trim(value) == \"\"",
    "end",
    "",
    "-- compact() подготавливает короткий текст для радио-ответов и KV-хранилища.",
    "-- Символ \"|\" запрещён в имени, потому что он используется как разделитель",
    "-- полей в сохранённой статистике.",
    "local function compact(value, limit)",
    "    local text = trim(value)",
    "    text = string.gsub(text, \"[\\r\\n|]+\", \" \")",
    "    text = string.gsub(text, \"%s+\", \" \")",
    "",
    "    if limit ~= nil and string.len(text) > limit then",
    "        return string.sub(text, 1, limit - 1) .. \"~\"",
    "    end",
    "",
    "    return text",
    "end",
    "",
    "local function valid_number(value)",
    "    return type(value) == \"number\"",
    "            and value == value",
    "            and value ~= math.huge",
    "            and value ~= -math.huge",
    "end",
    "",
    "-- RSSI в Meshtastic обычно отрицательный. Значения вроде 0 или слишком",
    "-- маленькие числа считаем отсутствующими/некорректными, чтобы они не портили",
    "-- среднюю статистику.",
    "local function valid_rssi(value)",
    "    return valid_number(value) and value < 0 and value > -250",
    "end",
    "",
    "local function valid_hops(value)",
    "    return valid_number(value) and value >= 0 and value < 100",
    "end",
    "",
    "-- LuaJ в этой sandbox-среде не округляет float через string.format(\"%.1f\", n),",
    "-- поэтому числа форматируются вручную через целочисленное округление.",
    "local function fixed_number_text(value, decimals)",
    "    decimals = math.floor(tonumber(decimals) or 0)",
    "    if decimals < 0 then",
    "        decimals = 0",
    "    elseif decimals > 6 then",
    "        decimals = 6",
    "    end",
    "",
    "    local scale = 1",
    "    for _ = 1, decimals do",
    "        scale = scale * 10",
    "    end",
    "",
    "    local scaled",
    "    if value >= 0 then",
    "        scaled = math.floor(value * scale + 0.5)",
    "    else",
    "        scaled = math.ceil(value * scale - 0.5)",
    "    end",
    "",
    "    local sign = \"\"",
    "    if scaled < 0 then",
    "        sign = \"-\"",
    "        scaled = -scaled",
    "    end",
    "",
    "    local whole = math.floor(scaled / scale)",
    "    if decimals == 0 then",
    "        return sign .. tostring(whole)",
    "    end",
    "",
    "    local fraction = scaled - whole * scale",
    "    local fraction_text = tostring(fraction)",
    "    while string.len(fraction_text) < decimals do",
    "        fraction_text = \"0\" .. fraction_text",
    "    end",
    "",
    "    return sign .. tostring(whole) .. \".\" .. fraction_text",
    "end",
    "",
    "local function trim_decimal_zeros(text)",
    "    if string.find(text, \"%.\") == nil then",
    "        return text",
    "    end",
    "",
    "    while string.sub(text, -1) == \"0\" do",
    "        text = string.sub(text, 1, -2)",
    "    end",
    "    if string.sub(text, -1) == \".\" then",
    "        text = string.sub(text, 1, -2)",
    "    end",
    "    if text == \"-0\" then",
    "        return \"0\"",
    "    end",
    "",
    "    return text",
    "end",
    "",
    "-- number_text() форматирует числа для сообщений пользователю.",
    "-- stored_number() форматирует числа для KV: компактно и без лишних нулей.",
    "local function number_text(value, decimals)",
    "    if not valid_number(value) then",
    "        return \"n/a\"",
    "    end",
    "",
    "    return trim_decimal_zeros(fixed_number_text(value, decimals or 0))",
    "end",
    "",
    "local function stored_number(value)",
    "    if not valid_number(value) then",
    "        return \"\"",
    "    end",
    "",
    "    return trim_decimal_zeros(fixed_number_text(value, 3))",
    "end",
    "",
    "local function to_number(value, fallback)",
    "    local parsed = tonumber(value)",
    "    if parsed == nil then",
    "        return fallback",
    "    end",
    "    return parsed",
    "end",
    "",
    "local function split_fields(value)",
    "    local fields = {}",
    "    if value == nil then",
    "        return fields",
    "    end",
    "",
    "    for part in string.gmatch(tostring(value) .. \"|\", \"(.-)|\") do",
    "        fields[#fields + 1] = part",
    "    end",
    "",
    "    return fields",
    "end",
    "",
    "-- Структура статистики в памяти.",
    "--",
    "-- count      - сколько ping/test/пинг было принято от этой ноды;",
    "-- *_count    - сколько корректных числовых значений попало в метрику;",
    "-- *_sum      - сумма для расчёта среднего;",
    "-- *_min/max  - худшее/лучшее наблюдение;",
    "-- last_*     - последние значения из последнего ping;",
    "-- last_seen  - Unix time последнего ping;",
    "-- name       - короткое имя отправителя, если MeshApp его знает.",
    "local function empty_stats()",
    "    return {",
    "        count = 0,",
    "        snr_count = 0,",
    "        snr_sum = 0,",
    "        snr_min = nil,",
    "        snr_max = nil,",
    "        rssi_count = 0,",
    "        rssi_sum = 0,",
    "        rssi_min = nil,",
    "        rssi_max = nil,",
    "        hops_count = 0,",
    "        hops_sum = 0,",
    "        hops_min = nil,",
    "        hops_max = nil,",
    "        last_snr = nil,",
    "        last_rssi = nil,",
    "        last_hops = nil,",
    "        last_seen = 0,",
    "        name = \"\"",
    "    }",
    "end",
    "",
    "-- mesh.kv хранит только строки, поэтому статистика сериализуется в одну",
    "-- компактную строку:",
    "--",
    "-- count|snr_count|snr_sum|snr_min|snr_max|rssi_count|rssi_sum|...",
    "--",
    "-- Такой формат намеренно простой: его легко читать и менять без JSON-библиотеки.",
    "-- Если в будущей версии нужно добавить поле, добавляйте его в конец строки,",
    "-- чтобы старые записи продолжали декодироваться.",
    "local function decode_stats(value)",
    "    local stats = empty_stats()",
    "    local f = split_fields(value)",
    "",
    "    stats.count = to_number(f[1], 0)",
    "    stats.snr_count = to_number(f[2], 0)",
    "    stats.snr_sum = to_number(f[3], 0)",
    "    stats.snr_min = to_number(f[4], nil)",
    "    stats.snr_max = to_number(f[5], nil)",
    "    stats.rssi_count = to_number(f[6], 0)",
    "    stats.rssi_sum = to_number(f[7], 0)",
    "    stats.rssi_min = to_number(f[8], nil)",
    "    stats.rssi_max = to_number(f[9], nil)",
    "    stats.hops_count = to_number(f[10], 0)",
    "    stats.hops_sum = to_number(f[11], 0)",
    "    stats.hops_min = to_number(f[12], nil)",
    "    stats.hops_max = to_number(f[13], nil)",
    "    stats.last_snr = to_number(f[14], nil)",
    "    stats.last_rssi = to_number(f[15], nil)",
    "    stats.last_hops = to_number(f[16], nil)",
    "    stats.last_seen = to_number(f[17], 0)",
    "    stats.name = compact(f[18] or \"\", 24)",
    "",
    "    return stats",
    "end",
    "",
    "-- Обратная операция к decode_stats(): таблица -> строка для mesh.kv.set().",
    "local function encode_stats(stats)",
    "    return table.concat({",
    "        stored_number(stats.count),",
    "        stored_number(stats.snr_count),",
    "        stored_number(stats.snr_sum),",
    "        stored_number(stats.snr_min),",
    "        stored_number(stats.snr_max),",
    "        stored_number(stats.rssi_count),",
    "        stored_number(stats.rssi_sum),",
    "        stored_number(stats.rssi_min),",
    "        stored_number(stats.rssi_max),",
    "        stored_number(stats.hops_count),",
    "        stored_number(stats.hops_sum),",
    "        stored_number(stats.hops_min),",
    "        stored_number(stats.hops_max),",
    "        stored_number(stats.last_snr),",
    "        stored_number(stats.last_rssi),",
    "        stored_number(stats.last_hops),",
    "        stored_number(stats.last_seen),",
    "        compact(stats.name or \"\", 24)",
    "    }, \"|\")",
    "end",
    "",
    "-- Все ключи статистики начинаются с KV_PREFIX. Это позволяет top_reply()",
    "-- отличать записи нод от любых других ключей, если скрипт будет расширяться.",
    "local function load_stats(node_id)",
    "    return decode_stats(mesh.kv.get(KV_PREFIX .. tostring(node_id)))",
    "end",
    "",
    "local function save_stats(node_id, stats)",
    "    mesh.kv.set(KV_PREFIX .. tostring(node_id), encode_stats(stats))",
    "end",
    "",
    "-- Универсальный накопитель для числовых метрик. Он используется одинаково",
    "-- для snr, rssi и hops, поэтому код update_node_stats остаётся коротким.",
    "local function add_number(stats, prefix, value)",
    "    if not valid_number(value) then",
    "        return",
    "    end",
    "",
    "    local count_key = prefix .. \"_count\"",
    "    local sum_key = prefix .. \"_sum\"",
    "    local min_key = prefix .. \"_min\"",
    "    local max_key = prefix .. \"_max\"",
    "",
    "    stats[count_key] = (stats[count_key] or 0) + 1",
    "    stats[sum_key] = (stats[sum_key] or 0) + value",
    "",
    "    if stats[min_key] == nil or value < stats[min_key] then",
    "        stats[min_key] = value",
    "    end",
    "",
    "    if stats[max_key] == nil or value > stats[max_key] then",
    "        stats[max_key] = value",
    "    end",
    "end",
    "",
    "-- Среднее считается только по валидным значениям метрики. Например, если RSSI",
    "-- не пришёл или пришёл как 0, он не должен попадать в avg RSSI.",
    "local function average(stats, prefix)",
    "    local count = stats[prefix .. \"_count\"] or 0",
    "    if count <= 0 then",
    "        return nil",
    "    end",
    "    return (stats[prefix .. \"_sum\"] or 0) / count",
    "end",
    "",
    "local function sender_label(msg, node_id)",
    "    local name = compact(msg.sender_name, 24)",
    "    if name ~= \"\" then",
    "        return name",
    "    end",
    "    return tostring(node_id or \"unknown\")",
    "end",
    "",
    "-- Единственное место, где статистика меняется.",
    "-- Важно: команды @MeshAppAir stats/top эту функцию не вызывают, иначе команда",
    "-- сама бы увеличивала n и сбрасывала last_seen на \"0s ago\".",
    "local function update_node_stats(msg)",
    "    if is_blank(msg.from) then",
    "        return nil",
    "    end",
    "",
    "    local node_id = tostring(msg.from)",
    "    local stats = load_stats(node_id)",
    "    local snr = valid_number(msg.rx_snr) and msg.rx_snr or nil",
    "    local rssi = valid_rssi(msg.rx_rssi) and msg.rx_rssi or nil",
    "    local hops = valid_hops(msg.hops) and msg.hops or nil",
    "",
    "    stats.count = (stats.count or 0) + 1",
    "    stats.name = sender_label(msg, node_id)",
    "    stats.last_seen = math.floor(mesh.now())",
    "",
    "    add_number(stats, \"snr\", snr)",
    "    add_number(stats, \"rssi\", rssi)",
    "    add_number(stats, \"hops\", hops)",
    "",
    "    if snr ~= nil then",
    "        stats.last_snr = snr",
    "    end",
    "    if rssi ~= nil then",
    "        stats.last_rssi = rssi",
    "    end",
    "    if hops ~= nil then",
    "        stats.last_hops = hops",
    "    end",
    "",
    "    save_stats(node_id, stats)",
    "    return stats",
    "end",
    "",
    "-- link_score() переводит радиометрики в оценку 0..100.",
    "--",
    "-- Идея простая:",
    "-- - высокий SNR лучше низкого;",
    "-- - RSSI ближе к 0 обычно сильнее, чем -115;",
    "-- - прямой линк лучше маршрута через несколько hops.",
    "--",
    "-- Это не физически точная модель канала, а практическая эвристика для",
    "-- быстрых сравнений. Пороги можно менять под свой регион, пресет и антенны.",
    "local function link_score(snr, rssi, hops)",
    "    local score = 100",
    "",
    "    if valid_number(snr) then",
    "        if snr >= 8 then",
    "            score = score",
    "        elseif snr >= 4 then",
    "            score = score - 10",
    "        elseif snr >= 0 then",
    "            score = score - 25",
    "        elseif snr >= -5 then",
    "            score = score - 45",
    "        else",
    "            score = score - 65",
    "        end",
    "    else",
    "        score = score - 20",
    "    end",
    "",
    "    if valid_rssi(rssi) then",
    "        if rssi >= -95 then",
    "            score = score",
    "        elseif rssi >= -105 then",
    "            score = score - 8",
    "        elseif rssi >= -115 then",
    "            score = score - 18",
    "        else",
    "            score = score - 30",
    "        end",
    "    else",
    "        score = score - 5",
    "    end",
    "",
    "    if valid_hops(hops) then",
    "        if hops <= 0 then",
    "            score = score",
    "        elseif hops == 1 then",
    "            score = score - 10",
    "        elseif hops == 2 then",
    "            score = score - 22",
    "        else",
    "            score = score - 35",
    "        end",
    "    else",
    "        score = score - 5",
    "    end",
    "",
    "    if score < 0 then",
    "        score = 0",
    "    elseif score > 100 then",
    "        score = 100",
    "    end",
    "",
    "    return math.floor(score + 0.5)",
    "end",
    "",
    "-- Буквенная оценка нужна, чтобы человек быстро понял качество без чтения",
    "-- всех чисел. A/B/C/D/F специально оставлены латиницей: они компактные и",
    "-- хорошо помещаются в Meshtastic-сообщение.",
    "local function grade_for(score)",
    "    if score >= 85 then",
    "        return \"A\", \"excellent\"",
    "    elseif score >= 70 then",
    "        return \"B\", \"good\"",
    "    elseif score >= 55 then",
    "        return \"C\", \"usable\"",
    "    elseif score >= 40 then",
    "        return \"D\", \"weak\"",
    "    end",
    "    return \"F\", \"bad\"",
    "end",
    "",
    "-- Emoji показывают качество визуально, но используются умеренно: каждый emoji",
    "-- занимает несколько байт в UTF-8, а размер радиосообщения ограничен.",
    "local function grade_icon(grade)",
    "    if grade == \"A\" then",
    "        return \"🟢\"",
    "    elseif grade == \"B\" then",
    "        return \"🟡\"",
    "    elseif grade == \"C\" then",
    "        return \"🟠\"",
    "    elseif grade == \"D\" then",
    "        return \"🔴\"",
    "    end",
    "    return \"⚫\"",
    "end",
    "",
    "-- Возвращаем не отдельные значения, а таблицу. Так удобнее передавать оценку",
    "-- между функциями и расширять её в будущем.",
    "local function quality(snr, rssi, hops)",
    "    local score = link_score(snr, rssi, hops)",
    "    local grade, label = grade_for(score)",
    "    return {",
    "        score = score,",
    "        grade = grade,",
    "        label = label",
    "    }",
    "end",
    "",
    "-- В Lua sandbox нет os.date(), поэтому время форматируется вручную от mesh.now().",
    "-- Здесь используется UTC+3, потому что скрипт изначально делался для такой зоны.",
    "-- Если нужна другая зона, поменяйте 3 * 3600.",
    "local function hhmm_utc_plus_3()",
    "    local now = mesh.now() + 3 * 3600",
    "    local hh = math.floor((now % 86400) / 3600)",
    "    local mm = math.floor((now % 3600) / 60)",
    "    return string.format(\"%02d:%02d\", hh, mm)",
    "end",
    "",
    "-- hops может отсутствовать, если MeshApp не смог вычислить hop distance.",
    "-- В таком случае в ответе показываем n/a, а не 0, чтобы не вводить в заблуждение.",
    "local function hops_text(value)",
    "    if not valid_hops(value) then",
    "        return \"n/a\"",
    "    end",
    "    return tostring(math.floor(value + 0.5))",
    "end",
    "",
    "-- age_text() нужен для stats: показывает, насколько давно был последний ping",
    "-- от этой ноды. Команды stats/top не обновляют last_seen.",
    "local function age_text(epoch)",
    "    if not valid_number(epoch) or epoch <= 0 then",
    "        return \"n/a\"",
    "    end",
    "",
    "    local seconds = math.floor(mesh.now() - epoch)",
    "    if seconds < 0 then",
    "        seconds = 0",
    "    end",
    "",
    "    if seconds < 60 then",
    "        return tostring(seconds) .. \"s ago\"",
    "    elseif seconds < 3600 then",
    "        return tostring(math.floor(seconds / 60)) .. \"m ago\"",
    "    elseif seconds < 86400 then",
    "        return tostring(math.floor(seconds / 3600)) .. \"h ago\"",
    "    end",
    "",
    "    return tostring(math.floor(seconds / 86400)) .. \"d ago\"",
    "end",
    "",
    "-- Короткий ответ на ping/test/пинг.",
    "-- Он намеренно занимает одну строку: такие ответы чаще помещаются в один",
    "-- Meshtastic packet и меньше засоряют общий канал.",
    "local function ping_reply(msg, stats)",
    "    local snr = valid_number(msg.rx_snr) and msg.rx_snr or nil",
    "    local rssi = valid_rssi(msg.rx_rssi) and msg.rx_rssi or nil",
    "    local hops = valid_hops(msg.hops) and msg.hops or nil",
    "    local q = quality(snr, rssi, hops)",
    "",
    "    return table.concat({",
    "        \"📡 \" .. SHORT_NAME .. \" \" .. grade_icon(q.grade) .. q.grade .. \"/\" .. tostring(q.score),",
    "        \"SNR \" .. number_text(snr, 1),",
    "        \"RSSI \" .. number_text(rssi, 0),",
    "        \"h\" .. hops_text(hops),",
    "        \"n\" .. tostring(math.floor((stats and stats.count) or 1)),",
    "        hhmm_utc_plus_3()",
    "    }, \" | \")",
    "end",
    "",
    "-- Для stats/top показываем короткое имя ноды, если оно есть. Полный node_id",
    "-- остаётся fallback-значением, потому что имя может отсутствовать.",
    "local function node_title(node_id, stats)",
    "    local name = compact(stats and stats.name or \"\", 14)",
    "    if name == \"\" or name == tostring(node_id) then",
    "        return tostring(node_id)",
    "    end",
    "    return name",
    "end",
    "",
    "-- Подробная статистика только по ноде, которая запросила stats.",
    "-- Здесь используются средние значения, best/worst SNR и последние метрики.",
    "local function stats_reply(node_id, stats)",
    "    if stats == nil or (stats.count or 0) <= 0 then",
    "        return \"📡 \" .. BOT_NAME .. \": no samples for \" .. tostring(node_id)",
    "    end",
    "",
    "    local avg_snr = average(stats, \"snr\")",
    "    local avg_rssi = average(stats, \"rssi\")",
    "    local avg_hops = average(stats, \"hops\")",
    "    local q = quality(avg_snr, avg_rssi, avg_hops)",
    "",
    "    local lines = {",
    "        \"📡 Stats \" .. node_title(node_id, stats),",
    "        \"📊 n\" .. tostring(math.floor(stats.count)) .. \" · \" .. age_text(stats.last_seen),",
    "        \"🏅 \" .. grade_icon(q.grade) .. q.grade .. \"/\" .. tostring(q.score) .. \" \" .. q.label,",
    "        \"📶 avg SNR \" .. number_text(avg_snr, 1)",
    "                .. \" RSSI \" .. number_text(avg_rssi, 0)",
    "                .. \" h\" .. number_text(avg_hops, 1),",
    "        \"🎯 SNR \" .. number_text(stats.snr_max, 1) .. \"/\" .. number_text(stats.snr_min, 1)",
    "                .. \" · last \" .. number_text(stats.last_snr, 1)",
    "                .. \"/\" .. number_text(stats.last_rssi, 0)",
    "                .. \"/h\" .. hops_text(stats.last_hops)",
    "    }",
    "",
    "    return table.concat(lines, \"\\n\")",
    "end",
    "",
    "-- top_reply() строит рейтинг по всем KV-ключам node:*.",
    "-- Сортировка:",
    "-- 1. выше link score;",
    "-- 2. больше samples n;",
    "-- 3. свежее last_seen.",
    "--",
    "-- TOP_LIMIT маленький специально: длинный топ легко превысит лимит сообщения.",
    "local function top_reply()",
    "    local rows = {}",
    "",
    "    for key, value in pairs(mesh.kv.list()) do",
    "        if string.sub(key, 1, string.len(KV_PREFIX)) == KV_PREFIX then",
    "            local node_id = string.sub(key, string.len(KV_PREFIX) + 1)",
    "            local stats = decode_stats(value)",
    "            local avg_snr = average(stats, \"snr\")",
    "            local avg_rssi = average(stats, \"rssi\")",
    "            local avg_hops = average(stats, \"hops\")",
    "            local q = quality(avg_snr, avg_rssi, avg_hops)",
    "",
    "            rows[#rows + 1] = {",
    "                node_id = node_id,",
    "                stats = stats,",
    "                avg_snr = avg_snr,",
    "                avg_rssi = avg_rssi,",
    "                avg_hops = avg_hops,",
    "                score = q.score,",
    "                grade = q.grade",
    "            }",
    "        end",
    "    end",
    "",
    "    if #rows == 0 then",
    "        return \"🏆 \" .. BOT_NAME .. \" top: no samples yet\"",
    "    end",
    "",
    "    table.sort(rows, function(a, b)",
    "        if a.score ~= b.score then",
    "            return a.score > b.score",
    "        end",
    "        if (a.stats.count or 0) ~= (b.stats.count or 0) then",
    "            return (a.stats.count or 0) > (b.stats.count or 0)",
    "        end",
    "        return (a.stats.last_seen or 0) > (b.stats.last_seen or 0)",
    "    end)",
    "",
    "    local lines = { \"🏆 \" .. BOT_NAME .. \" top\" }",
    "    local limit = math.min(TOP_LIMIT, #rows)",
    "",
    "    for i = 1, limit do",
    "        local row = rows[i]",
    "        local name = compact(row.stats.name, 10)",
    "        if name == \"\" then",
    "            name = row.node_id",
    "        end",
    "",
    "        lines[#lines + 1] = tostring(i) .. \". \" .. grade_icon(row.grade)",
    "                .. \" \" .. name .. \" \" .. row.grade .. \"/\" .. tostring(row.score)",
    "                .. \" SNR \" .. number_text(row.avg_snr, 1)",
    "                .. \" h\" .. number_text(row.avg_hops, 1)",
    "                .. \" n\" .. tostring(math.floor(row.stats.count or 0))",
    "    end",
    "",
    "    return table.concat(lines, \"\\n\")",
    "end",
    "",
    "-- Help переведён на русский, но команды оставлены как есть:",
    "-- @MeshAppAir stats и @MeshAppAir top.",
    "-- Так старые инструкции и автодополнение не ломаются.",
    "local function help_reply()",
    "    return \"📡 \" .. BOT_NAME .. \": ping/test в Ping. Команды: @MeshAppAir stats, @MeshAppAir top\"",
    "end",
    "",
    "-- Команды приходят как обычные сообщения, потому что это AIR_BOT.",
    "-- У AIR_BOT нет on_command(command), поэтому разбираем @MeshAppAir ... внутри",
    "-- on_message(msg). HANDLE хранится в нижнем регистре, а текст сообщения перед",
    "-- сравнением тоже нормализуется через lower_trim().",
    "local function parse_command(text)",
    "    local normalized = lower_trim(text)",
    "    if normalized == \"\" then",
    "        return nil",
    "    end",
    "",
    "    if normalized == HANDLE then",
    "        return \"help\"",
    "    end",
    "",
    "    if string.sub(normalized, 1, string.len(HANDLE)) ~= HANDLE then",
    "        return nil",
    "    end",
    "",
    "    local separator = string.sub(normalized, string.len(HANDLE) + 1, string.len(HANDLE) + 1)",
    "    if separator ~= \" \" and separator ~= \"\\t\" then",
    "        return nil",
    "    end",
    "",
    "    local rest = trim(string.sub(normalized, string.len(HANDLE) + 1))",
    "",
    "    if rest == \"stats\" or rest == \"stat\" then",
    "        return \"stats\"",
    "    elseif rest == \"top\" then",
    "        return \"top\"",
    "    elseif rest == \"help\" or rest == \"\" then",
    "        return \"help\"",
    "    end",
    "",
    "    return \"unknown\"",
    "end",
    "",
    "-- Список ping-триггеров. Добавлять алиасы безопасно здесь: остальная логика",
    "-- не зависит от конкретного текста команды.",
    "local function is_ping_text(text)",
    "    local normalized = lower_trim(text)",
    "    return normalized == \"ping\" or normalized == \"test\" or normalized == \"ping?\" or normalized == \"пинг\"",
    "end",
    "",
    "-- По умолчанию бот слушает:",
    "-- - DM, чтобы можно было тестировать линк напрямую;",
    "-- - канал с именем Ping, чтобы не отвечать на каждое слово ping в других чатах.",
    "local function is_ping_chat(msg)",
    "    if msg.chat_type == \"dm\" then",
    "        return true",
    "    end",
    "",
    "    if msg.chat_type ~= \"channel\" then",
    "        return false",
    "    end",
    "",
    "    return lower_trim(msg.channel_name) == PING_CHANNEL",
    "end",
    "",
    "-- mesh.owner() может быть недоступен в редких состояниях подключения, поэтому",
    "-- вызов обёрнут в pcall. Если owner неизвестен, guard просто не сработает.",
    "local function owner_node_id()",
    "    local ok, owner = pcall(function()",
    "        return mesh.owner()",
    "    end)",
    "",
    "    if ok and owner ~= nil and not is_blank(owner.node_id) then",
    "        return lower_trim(owner.node_id)",
    "    end",
    "",
    "    return \"\"",
    "end",
    "",
    "-- Защита от собственного сообщения. Некоторые транспорты могут отдать локальный",
    "-- ping как входящее сообщение или как эхо с outgoing=false. Без этой проверки",
    "-- бот может ответить сам себе, а в худшем случае остановиться из-за ошибки.",
    "local function is_own_message(msg)",
    "    if msg == nil or is_blank(msg.from) then",
    "        return false",
    "    end",
    "",
    "    local owner_id = owner_node_id()",
    "    return owner_id ~= \"\" and lower_trim(msg.from) == owner_id",
    "end",
    "",
    "-- Любая отправка по радио может завершиться ошибкой: нет подключения, неверный",
    "-- chat scope, транспорт занят и т.д. reply_in_chat() не даёт такой ошибке",
    "-- остановить скрипт, а пишет её в лог.",
    "local function reply_in_chat(msg, text)",
    "    local ok, err = pcall(function()",
    "        mesh.chat.reply(msg, text)",
    "    end)",
    "",
    "    if not ok then",
    "        mesh.log(BOT_NAME .. \" reply failed: \" .. tostring(err))",
    "    end",
    "end",
    "",
    "-- Пока эта функция просто вызывает reply_in_chat(). Она оставлена отдельной",
    "-- точкой расширения: если позже понадобится другой способ ответа для команд,",
    "-- менять нужно будет только её.",
    "local function reply_to_requester(msg, text)",
    "    reply_in_chat(msg, text)",
    "end",
    "",
    "-- Главная бизнес-логика бота.",
    "--",
    "-- Порядок важен:",
    "-- 1. Игнорируем системные, исходящие и собственные сообщения.",
    "-- 2. Если сообщение является командой @MeshAppAir, только читаем статистику.",
    "-- 3. Если сообщение не ping/test/пинг или пришло не из нужного чата, выходим.",
    "-- 4. Для реального ping обновляем stats и отвечаем в тот же чат.",
    "local function handle_message(msg)",
    "    if msg == nil or msg.outgoing or msg.system or is_own_message(msg) then",
    "        return",
    "    end",
    "",
    "    local command = parse_command(msg.text)",
    "    if command ~= nil then",
    "        local node_id = tostring(msg.from or \"unknown\")",
    "        local stats = load_stats(node_id)",
    "",
    "        if command == \"stats\" then",
    "            reply_to_requester(msg, stats_reply(node_id, stats))",
    "        elseif command == \"top\" then",
    "            reply_to_requester(msg, top_reply())",
    "        elseif command == \"help\" then",
    "            reply_to_requester(msg, help_reply())",
    "        else",
    "            reply_to_requester(msg, \"📡 \" .. BOT_NAME .. \" commands: stats, top\")",
    "        end",
    "",
    "        return",
    "    end",
    "",
    "    if not is_ping_text(msg.text) or not is_ping_chat(msg) then",
    "        return",
    "    end",
    "",
    "    local stats = update_node_stats(msg)",
    "",
    "    mesh.sleep(math.random(1, 5))",
    "    reply_in_chat(msg, ping_reply(msg, stats))",
    "end",
    "",
    "-- Единственный публичный callback для AIR_BOT.",
    "-- Весь handle_message завёрнут в pcall, чтобы одна неожиданная ошибка не",
    "-- остановила долгоживущий бот. Это полезный шаблон для любых on_message-ботов.",
    "function on_message(msg)",
    "    local ok, err = pcall(function()",
    "        handle_message(msg)",
    "    end)",
    "",
    "    if not ok then",
    "        mesh.log(BOT_NAME .. \" on_message failed: \" .. tostring(err))",
    "    end",
    "end"
  ],
  "botType": "AIR_BOT",
  "automationName": ""
}
