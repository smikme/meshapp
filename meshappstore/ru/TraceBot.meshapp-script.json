  "guid": "04953eca-59b1-4406-bc4a-54f4d8a5a1c1",
  "icon": "🛣️",
  "name": "TraceBot",
  "description": "@tracebot - строит маршрут и выводит результат в чат",
  "author": "MeshApp",
  "codeLines": [
    "  -- Lua @tracebot для MeshApp",
    "  -- Тип скрипта: Автоматизация",
    "  -- Команда: @tracebot",
    "  --",
    "  -- Сценарий:",
    "  -- 1. Пользователь выбирает @tracebot в чате.",
    "  -- 2. Скрипт открывает inline pickup ноды через mesh.ui.pick_node().",
    "  -- 3. После выбора отправляет mesh.traceroute.request().",
    "  -- 4. Все сообщения пишет персистентно через mesh.chat.bot_message().",
    "",
    "  local TRACE_PREFIX = \"🔍 Traceroute → \"",
    "  local PICK_REQUEST = \"tracebot.pick_target\"",
    "  local TRACE_REQUEST = \"tracebot.request\"",
    "  local TRACE_TIMEOUT_SECONDS = 30",
    "",
    "  local function not_blank(value)",
    "      return value ~= nil and tostring(value) ~= \"\"",
    "  end",
    "",
    "  local function node_label(node)",
    "      if node == nil then return \"\" end",
    "      if not_blank(node.long_name) then return node.long_name end",
    "      if not_blank(node.short_name) then return node.short_name end",
    "      if not_blank(node.node_id) then return node.node_id end",
    "      return tostring(node.node_num or \"\")",
    "  end",
    "",
    "  local function target_label(event)",
    "      if not_blank(event.target_name) then return event.target_name end",
    "      if not_blank(event.target_node_id) then return event.target_node_id end",
    "      return tostring(event.target_node_num or \"\")",
    "  end",
    "",
    "  -- Таблица известных нод: node_num -> readable name.",
    "  -- Нужна, чтобы hops в маршруте выводились именами.",
    "  local function known_node_names()",
    "      local names = {}",
    "",
    "      for _, node in ipairs(mesh.chat.nodes()) do",
    "          if node.node_num ~= nil then",
    "              names[tostring(node.node_num)] = node_label(node)",
    "          end",
    "      end",
    "",
    "      return names",
    "  end",
    "",
    "  -- Возвращает имя hop-ноды.",
    "  -- Приоритет:",
    "  -- 1. Имя из локальной базы нод.",
    "  -- 2. Нормальный node_id вида !efffff02.",
    "  -- 3. unknown.",
    "  local function hop_name(index, hops, hop_ids, names)",
    "      local node_num = hops[index]",
    "      local node_id = hop_ids ~= nil and hop_ids[index] or nil",
    "",
    "      if node_num ~= nil then",
    "          local known = names[tostring(node_num)]",
    "          if known ~= nil and known ~= \"\" then",
    "              return known",
    "          end",
    "      end",
    "",
    "      if node_id ~= nil and node_id ~= \"\" then",
    "          return node_id",
    "      end",
    "",
    "      return \"unknown\"",
    "  end",
    "",
    "  local function has_values(values)",
    "      return values ~= nil and #values > 0",
    "  end",
    "",
    "  local function snr_text(snr)",
    "      return string.format(\"%.1f\", snr):gsub(\",\", \".\")",
    "  end",
    "",
    "  local function append_route_line(parts, start_name, finish_name, hops, hop_ids, snrs, names)",
    "      table.insert(parts, start_name)",
    "",
    "      hops = hops or {}",
    "      hop_ids = hop_ids or {}",
    "      snrs = snrs or {}",
    "",
    "      for i = 1, #hops + 1 do",
    "          if snrs[i] ~= nil then",
    "              table.insert(parts, \" →\" .. snr_text(snrs[i]) .. \"dB→ \")",
    "          else",
    "              table.insert(parts, \" → \")",
    "          end",
    "",
    "          if hops[i] ~= nil then",
    "              table.insert(parts, hop_name(i, hops, hop_ids, names))",
    "          else",
    "              table.insert(parts, finish_name)",
    "          end",
    "      end",
    "  end",
    "",
    "  local function format_traceroute(event)",
    "      local route = event.route",
    "      local target = target_label(event)",
    "",
    "      if route == nil then",
    "          return TRACE_PREFIX .. target .. \"\\nНет данных маршрута\"",
    "      end",
    "",
    "      local names = known_node_names()",
    "      local lines = { TRACE_PREFIX .. target }",
    "",
    "      local parts = {}",
    "      append_route_line(",
    "          parts,",
    "          \"Я\",",
    "          target,",
    "          route.route,",
    "          route.route_ids,",
    "          route.snr_towards,",
    "          names",
    "      )",
    "      table.insert(lines, table.concat(parts))",
    "",
    "      if has_values(route.route_back) or has_values(route.route_back_ids) or has_values(route.snr_back) then",
    "          parts = {}",
    "          append_route_line(",
    "              parts,",
    "              target,",
    "              \"Я\",",
    "              route.route_back,",
    "              route.route_back_ids,",
    "              route.snr_back,",
    "              names",
    "          )",
    "          table.insert(lines, table.concat(parts))",
    "      end",
    "",
    "      return table.concat(lines, \"\\n\")",
    "  end",
    "",
    "  function on_command(command)",
    "      mesh.ui.pick_node({",
    "          name = PICK_REQUEST,",
    "          prompt = \"Выберите ноду для traceroute\",",
    "          query = command.arguments,",
    "          chat_type = command.chat_type,",
    "          chat_key = command.chat_key",
    "      })",
    "  end",
    "",
    "  function on_node_selected(event)",
    "      if event.name ~= PICK_REQUEST then",
    "          return",
    "      end",
    "",
    "      if event.cancelled or event.node == nil then",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"❌ Traceroute: нода не выбрана\")",
    "          return",
    "      end",
    "",
    "      local name = node_label(event.node)",
    "",
    "      mesh.chat.bot_message(event.chat_type, event.chat_key, TRACE_PREFIX .. name .. \": запрос отправлен\")",
    "",
    "      local ok, err = pcall(function()",
    "          mesh.traceroute.request(event.node, {",
    "              name = TRACE_REQUEST,",
    "              target_name = name,",
    "              chat_type = event.chat_type,",
    "              chat_key = event.chat_key,",
    "              timeout_seconds = TRACE_TIMEOUT_SECONDS",
    "          })",
    "      end)",
    "",
    "      if not ok then",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"❌ Traceroute → \" .. name .. \": \" .. tostring(err))",
    "      end",
    "  end",
    "",
    "  function on_traceroute(event)",
    "      if event.name ~= TRACE_REQUEST then",
    "          return",
    "      end",
    "",
    "      local name = target_label(event)",
    "",
    "      if event.ok then",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, format_traceroute(event))",
    "      elseif event.timeout then",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"❌ Traceroute → \" .. name .. \": ответ не получен\")",
    "      else",
    "          local reason = event.error or \"не удалось отправить запрос\"",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"❌ Traceroute → \" .. name .. \": \" .. reason)",
    "      end",
    "  end"
  ],
  "botType": "AUTOMATION_BOT",
  "automationName": "@tracebot"
}