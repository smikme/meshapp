  "guid": "76e0e628-3f44-49ac-a3c8-16c4e35d63d1",
  "icon": "🤷‍♂️",
  "name": "InfoBot",
  "description": "@infobot - выводит информацию о ноде",
  "author": "MeshApp",
  "codeLines": [
    "-- @infobot на Lua",
    "  -- Тип скрипта: Автоматизация",
    "  -- Имя автоматизации: @infobot",
    "",
    "  local REQUEST_NAME_PICK = \"infobot.pick_node\"",
    "  local REQUEST_NAME_INFO = \"infobot.nodeinfo\"",
    "",
    "  local function is_blank(value)",
    "      return value == nil or tostring(value):match(\"^%s*$\") ~= nil",
    "  end",
    "",
    "  local function line(parts, text)",
    "      if not is_blank(text) then",
    "          parts[#parts + 1] = text",
    "      end",
    "  end",
    "",
    "  local function format_public_key(value)",
    "      local original = tostring(value or \"\")",
    "      local hex = original:gsub(\"^0[xX]\", \"\"):gsub(\"[%s:]\", \"\")",
    "",
    "      if #hex == 0 or #hex % 2 ~= 0 or hex:find(\"[^%x]\") then",
    "          return original",
    "      end",
    "",
    "      local bytes = {}",
    "      for i = 1, #hex, 2 do",
    "          bytes[#bytes + 1] = tonumber(hex:sub(i, i + 1), 16)",
    "      end",
    "",
    "      local alphabet = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"",
    "      local encoded = {}",
    "      for i = 1, #bytes, 3 do",
    "          local a = bytes[i]",
    "          local b = bytes[i + 1]",
    "          local c = bytes[i + 2]",
    "",
    "          encoded[#encoded + 1] = alphabet:sub(math.floor(a / 4) + 1, math.floor(a / 4) + 1)",
    "          local second = (a % 4) * 16 + math.floor((b or 0) / 16)",
    "          encoded[#encoded + 1] = alphabet:sub(second + 1, second + 1)",
    "",
    "          if b ~= nil then",
    "              local third = (b % 16) * 4 + math.floor((c or 0) / 64)",
    "              encoded[#encoded + 1] = alphabet:sub(third + 1, third + 1)",
    "          else",
    "              encoded[#encoded + 1] = \"=\"",
    "          end",
    "",
    "          if c ~= nil then",
    "              encoded[#encoded + 1] = alphabet:sub((c % 64) + 1, (c % 64) + 1)",
    "          else",
    "              encoded[#encoded + 1] = \"=\"",
    "          end",
    "      end",
    "",
    "      return table.concat(encoded)",
    "  end",
    "",
    "  local function format_time(epoch)",
    "      if epoch == nil or epoch <= 0 then",
    "          return nil",
    "      end",
    "",
    "      local now = mesh.now()",
    "      local diff = math.floor(now - epoch)",
    "",
    "      if diff < 0 then",
    "          return tostring(epoch)",
    "      end",
    "      if diff < 60 then",
    "          return \"только что\"",
    "      end",
    "      if diff < 3600 then",
    "          return tostring(math.floor(diff / 60)) .. \" мин назад\"",
    "      end",
    "      if diff < 86400 then",
    "          return tostring(math.floor(diff / 3600)) .. \" ч назад\"",
    "      end",
    "      return tostring(math.floor(diff / 86400)) .. \" дн назад\"",
    "  end",
    "",
    "  local function format_uptime(seconds)",
    "      if seconds == nil or seconds <= 0 then",
    "          return nil",
    "      end",
    "      local hours = math.floor(seconds / 3600)",
    "      local minutes = math.floor((seconds % 3600) / 60)",
    "      return string.format(\"%dч %dм\", hours, minutes)",
    "  end",
    "",
    "  local function node_display_name(node)",
    "      if node == nil then",
    "          return \"нода\"",
    "      end",
    "      if not is_blank(node.long_name) then",
    "          if not is_blank(node.short_name) then",
    "              return node.long_name .. \" (\" .. node.short_name .. \")\"",
    "          end",
    "          return node.long_name",
    "      end",
    "      if not is_blank(node.short_name) then",
    "          return node.short_name",
    "      end",
    "      return node.node_id or tostring(node.node_num or \"нода\")",
    "  end",
    "",
    "  local function format_node_info(node)",
    "      local parts = {}",
    "",
    "      line(parts, \"📋 Информация о ноде\")",
    "      line(parts, \"━━━━━━━━━━━━━━━━━━━━\")",
    "",
    "      line(parts, \"👤 \" .. node_display_name(node))",
    "      line(parts, \"🆔 \" .. (node.node_id or tostring(node.node_num or \"\")))",
    "",
    "      if not is_blank(node.role) then",
    "          line(parts, \"🎭 \" .. node.role)",
    "      end",
    "",
    "      if not is_blank(node.hw_model) then",
    "          line(parts, \"📟 \" .. node.hw_model)",
    "      end",
    "",
    "      if node.battery ~= nil and node.battery > 0 then",
    "          local battery = string.format(\"🔋 %d%%\", node.battery)",
    "          if node.voltage ~= nil and node.voltage > 0 then",
    "              battery = battery .. string.format(\" (%.1fV)\", node.voltage)",
    "          end",
    "          line(parts, battery)",
    "      elseif node.voltage ~= nil and node.voltage > 0 then",
    "          line(parts, string.format(\"🔋 %.1fV\", node.voltage))",
    "      end",
    "",
    "      if node.snr ~= nil and node.snr ~= 0 then",
    "          line(parts, string.format(\"📡 SNR: %.1f dB\", node.snr))",
    "      end",
    "",
    "      if node.hops_away ~= nil and node.hops_away > 0 then",
    "          line(parts, \"🔗 Хопов: \" .. tostring(node.hops_away))",
    "      end",
    "",
    "      if node.latitude ~= nil and node.longitude ~= nil",
    "              and (node.latitude ~= 0 or node.longitude ~= 0) then",
    "          line(parts, string.format(\"📍 %.4f, %.4f\", node.latitude, node.longitude))",
    "      end",
    "",
    "      if node.altitude ~= nil and node.altitude ~= 0 then",
    "          line(parts, \"⛰️ \" .. tostring(node.altitude) .. \" м\")",
    "      end",
    "",
    "      if not is_blank(node.public_key) then",
    "          line(parts, \"🔐 \" .. format_public_key(node.public_key))",
    "      end",
    "",
    "      local last_heard = format_time(node.last_heard)",
    "      if last_heard ~= nil then",
    "          line(parts, \"🕓 \" .. last_heard)",
    "      end",
    "",
    "      local uptime = format_uptime(node.uptime_seconds)",
    "      if uptime ~= nil then",
    "          line(parts, \"⏱ \" .. uptime)",
    "      end",
    "",
    "      line(parts, \"━━━━━━━━━━━━━━━━━━━━\")",
    "      return table.concat(parts, \"\\n\")",
    "  end",
    "",
    "  function on_command(command)",
    "      mesh.chat.bot_message(",
    "          command.chat_type,",
    "          command.chat_key,",
    "          \"Выберите ноду для получения информации.\"",
    "      )",
    "",
    "      mesh.ui.pick_node({",
    "          name = REQUEST_NAME_PICK,",
    "          prompt = \"Выберите ноду\",",
    "          query = command.arguments,",
    "          chat_type = command.chat_type,",
    "          chat_key = command.chat_key",
    "      })",
    "  end",
    "",
    "  function on_node_selected(event)",
    "      if event.name ~= REQUEST_NAME_PICK then",
    "          return",
    "      end",
    "",
    "      if event.cancelled or event.node == nil then",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"Запрос информации отменен.\")",
    "          return",
    "      end",
    "",
    "      local target_name = node_display_name(event.node)",
    "",
    "      mesh.chat.bot_message(",
    "          event.chat_type,",
    "          event.chat_key,",
    "          \"Запрашиваю информацию о \" .. target_name .. \"...\"",
    "      )",
    "",
    "      mesh.nodeinfo.request(event.node, {",
    "          name = REQUEST_NAME_INFO,",
    "          target_name = target_name,",
    "          chat_type = event.chat_type,",
    "          chat_key = event.chat_key,",
    "          timeout_seconds = 60",
    "      })",
    "  end",
    "",
    "  function on_node_info(event)",
    "      if event.name ~= REQUEST_NAME_INFO then",
    "          return",
    "      end",
    "",
    "      if event.node ~= nil then",
    "          local text = format_node_info(event.node)",
    "",
    "          if event.cached then",
    "              text = text .. \"\\n\\n⚠️ Свежий ответ не получен, показаны данные из кэша.\"",
    "          end",
    "",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, text)",
    "          return",
    "      end",
    "",
    "      local target = event.target_name",
    "      if is_blank(target) then",
    "          target = event.target_node_id or \"нода\"",
    "      end",
    "",
    "      if event.timeout then",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"Информация по \" .. target .. \": ответ не получен\")",
    "      else",
    "          mesh.chat.bot_message(event.chat_type, event.chat_key, \"Информация по \" .. target .. \": ошибка запроса\")",
    "      end",
    "  end"
  ],
  "botType": "AUTOMATION_BOT",
  "automationName": "@infobot"
}
