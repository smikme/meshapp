{
  "format": "meshapp-lua-script",
  "version": 1,
  "scriptVersion": 19,
  "guid": "2f99377a-e17e-4a62-93f6-df750cdb39d5",
  "icon": "🌦️",
  "name": "WeatherBot",
  "description": "Русский чат-бот погоды для MeshApp: дефолтная Москва, кэш прогноза и ответы в mesh-сеть.",
  "author": "MeshApp",
  "codeLines": [
    "-- WeatherBot для MeshApp Lua.",
    "-- Чат-бот AIR_BOT: слушает команды из списка commands и отвечает обратно в mesh-сеть.",
    "",
    "-- Основные настройки бота. Меняйте их перед публикацией/установкой скрипта.",
    "local Bot = {",
    "    commands = { \"@weather\", \"@погода\" },",
    "",
    "    -- Локация по умолчанию для простой команды \"@weather\".",
    "    -- Если lat/lon заданы, бот не делает geocoding для дефолтного города.",
    "    default_place = {",
    "        name = \"Москва\",",
    "        query = \"Москва\",",
    "        lat = 55.7558,",
    "        lon = 37.6173",
    "    },",
    "",
    "    -- Настройки кэша и защиты эфира.",
    "    -- geo_cache_seconds хранит координаты городов, forecast_cache_seconds хранит прогноз.",
    "    cooldown = 20,",
    "    geo_cache_seconds = 30 * 24 * 60 * 60,",
    "    forecast_cache_seconds = 10 * 60,",
    "    stale_cache_seconds = 6 * 60 * 60,",
    "    reply_min_delay = 1,",
    "    reply_max_delay = 6,",
    "",
    "    -- Open-Meteo не всегда находит города по кириллице, поэтому для частых",
    "    -- русских названий держим понятные сервису варианты.",
    "    city_aliases = {",
    "        [\"москва\"] = \"Moscow\",",
    "        [\"санкт петербург\"] = \"Saint Petersburg\",",
    "        [\"питер\"] = \"Saint Petersburg\",",
    "        [\"нижний новгород\"] = \"Nizhny Novgorod\",",
    "        [\"ростов на дону\"] = \"Rostov-on-Don\",",
    "        [\"йошкар ола\"] = \"Yoshkar-Ola\",",
    "        [\"набережные челны\"] = \"Naberezhnye Chelny\",",
    "        [\"великий новгород\"] = \"Veliky Novgorod\",",
    "        [\"южно сахалинск\"] = \"Yuzhno-Sakhalinsk\",",
    "        [\"ханты мансийск\"] = \"Khanty-Mansiysk\"",
    "    }",
    "}",
    "",
    "-- Lua math.random без seed будет повторять одну и ту же последовательность.",
    "math.randomseed(math.floor(mesh.now() * 1000) % 2147483647)",
    "",
    "-- Небольшие утилиты форматирования. Они держатся отдельно, чтобы ответы были короткими.",
    "local function trim(value)",
    "    return tostring(value or \"\"):gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\")",
    "end",
    "",
    "local function ru_lower(value)",
    "    local text = string.lower(tostring(value or \"\"))",
    "    local upper = {",
    "        [\"А\"] = \"а\", [\"Б\"] = \"б\", [\"В\"] = \"в\", [\"Г\"] = \"г\", [\"Д\"] = \"д\",",
    "        [\"Е\"] = \"е\", [\"Ё\"] = \"ё\", [\"Ж\"] = \"ж\", [\"З\"] = \"з\", [\"И\"] = \"и\",",
    "        [\"Й\"] = \"й\", [\"К\"] = \"к\", [\"Л\"] = \"л\", [\"М\"] = \"м\", [\"Н\"] = \"н\",",
    "        [\"О\"] = \"о\", [\"П\"] = \"п\", [\"Р\"] = \"р\", [\"С\"] = \"с\", [\"Т\"] = \"т\",",
    "        [\"У\"] = \"у\", [\"Ф\"] = \"ф\", [\"Х\"] = \"х\", [\"Ц\"] = \"ц\", [\"Ч\"] = \"ч\",",
    "        [\"Ш\"] = \"ш\", [\"Щ\"] = \"щ\", [\"Ъ\"] = \"ъ\", [\"Ы\"] = \"ы\", [\"Ь\"] = \"ь\",",
    "        [\"Э\"] = \"э\", [\"Ю\"] = \"ю\", [\"Я\"] = \"я\"",
    "    }",
    "    for from, to in pairs(upper) do text = string.gsub(text, from, to) end",
    "    return text",
    "end",
    "",
    "local function low(value)",
    "    return ru_lower(value)",
    "end",
    "",
    "local function command_key(value)",
    "    local text = low(value)",
    "    local lookalikes = {",
    "        a = \"а\", e = \"е\", o = \"о\", p = \"р\", c = \"с\", x = \"х\", y = \"у\"",
    "    }",
    "    for from, to in pairs(lookalikes) do text = string.gsub(text, from, to) end",
    "    return text",
    "end",
    "",
    "local function word(text)",
    "    local head, tail = string.match(trim(text), \"^(%S+)%s*(.*)$\")",
    "    return head or \"\", tail or \"\"",
    "end",
    "",
    "local function round(value)",
    "    local n = tonumber(value)",
    "    if not n then return nil end",
    "    return n >= 0 and math.floor(n + 0.5) or math.ceil(n - 0.5)",
    "end",
    "",
    "local function signed(value)",
    "    local n = round(value)",
    "    if not n then return \"?\" end",
    "    return n > 0 and (\"+\" .. n) or tostring(n)",
    "end",
    "",
    "local function num(value)",
    "    local n = round(value)",
    "    return n and tostring(n) or \"?\"",
    "end",
    "",
    "local function pct(value)",
    "    local n = round(value)",
    "    if not n then return \"?\" end",
    "    if n < 0 then n = 0 elseif n > 100 then n = 100 end",
    "    return tostring(n)",
    "end",
    "",
    "local function maxn(...)",
    "    local best = nil",
    "    for i = 1, select(\"#\", ...) do",
    "        local value = select(i, ...)",
    "        local n = tonumber(value)",
    "        if n and (not best or n > best) then best = n end",
    "    end",
    "    return best",
    "end",
    "",
    "local function enc(value)",
    "    return tostring(value or \"\"):gsub(\"([^%w%-_%.~])\", function(c)",
    "        return string.format(\"%%%02X\", string.byte(c))",
    "    end)",
    "end",
    "",
    "local function city_key(value)",
    "    local key = low(trim(value))",
    "    key = string.gsub(key, \"ё\", \"е\")",
    "    key = string.gsub(key, \"[%-_]+\", \" \")",
    "    key = string.gsub(key, \"%s+\", \" \")",
    "    return trim(key)",
    "end",
    "",
    "local function translit_ru(value)",
    "    local text = ru_lower(value)",
    "    local letters = {",
    "        [\"а\"] = \"a\", [\"б\"] = \"b\", [\"в\"] = \"v\", [\"г\"] = \"g\", [\"д\"] = \"d\",",
    "        [\"е\"] = \"e\", [\"ё\"] = \"yo\", [\"ж\"] = \"zh\", [\"з\"] = \"z\", [\"и\"] = \"i\",",
    "        [\"й\"] = \"y\", [\"к\"] = \"k\", [\"л\"] = \"l\", [\"м\"] = \"m\", [\"н\"] = \"n\",",
    "        [\"о\"] = \"o\", [\"п\"] = \"p\", [\"р\"] = \"r\", [\"с\"] = \"s\", [\"т\"] = \"t\",",
    "        [\"у\"] = \"u\", [\"ф\"] = \"f\", [\"х\"] = \"kh\", [\"ц\"] = \"ts\", [\"ч\"] = \"ch\",",
    "        [\"ш\"] = \"sh\", [\"щ\"] = \"shch\", [\"ъ\"] = \"\", [\"ы\"] = \"y\", [\"ь\"] = \"\",",
    "        [\"э\"] = \"e\", [\"ю\"] = \"yu\", [\"я\"] = \"ya\"",
    "    }",
    "    for from, to in pairs(letters) do text = string.gsub(text, from, to) end",
    "    text = string.gsub(text, \"%s+\", \" \")",
    "    return trim(text)",
    "end",
    "",
    "-- Перевод погодных кодов Open-Meteo в короткий русский текст.",
    "local function weather_name(code)",
    "    local c = tonumber(code)",
    "    if c == 0 then return \"ясно\" end",
    "    if c == 1 or c == 2 or c == 3 then return \"облачно\" end",
    "    if c == 45 or c == 48 then return \"туман\" end",
    "    if c and c >= 51 and c <= 57 then return \"морось\" end",
    "    if c and c >= 61 and c <= 67 then return \"дождь\" end",
    "    if c == 71 or c == 73 or c == 75 or c == 77 then return \"снег\" end",
    "    if c == 80 or c == 81 or c == 82 then return \"ливень\" end",
    "    if c == 85 or c == 86 then return \"снегопад\" end",
    "    if c == 95 or c == 96 or c == 99 then return \"гроза\" end",
    "    return \"погода\"",
    "end",
    "",
    "local function weather_short(code)",
    "    local name = weather_name(code)",
    "    if name == \"облачно\" then return \"обл\" end",
    "    if name == \"морось\" then return \"мор\" end",
    "    if name == \"ливень\" then return \"лив\" end",
    "    if name == \"снегопад\" then return \"снег\" end",
    "    return name",
    "end",
    "",
    "local function is_thunder(code)",
    "    local c = tonumber(code)",
    "    return c == 95 or c == 96 or c == 99",
    "end",
    "",
    "local function is_snow(code)",
    "    local c = tonumber(code)",
    "    return c == 71 or c == 73 or c == 75 or c == 77 or c == 85 or c == 86",
    "end",
    "",
    "function Bot:random_reply_delay()",
    "    local min_delay = math.floor(tonumber(self.reply_min_delay) or 1)",
    "    local max_delay = math.floor(tonumber(self.reply_max_delay) or 6)",
    "    if min_delay < 1 then min_delay = 1 end",
    "    if max_delay < min_delay then max_delay = min_delay end",
    "    return math.random(min_delay, max_delay)",
    "end",
    "",
    "function Bot:send_reply(msg, text)",
    "    local body = trim(text)",
    "    if body ~= \"\" and not mesh.chat.reply(msg, body) then",
    "        mesh.log(\"WeatherBot failed to send reply\")",
    "    end",
    "end",
    "",
    "function Bot:reply(msg, text)",
    "    local body = trim(text)",
    "    if body == \"\" then return end",
    "",
    "    self.reply_jobs = self.reply_jobs or {}",
    "    self.next_reply_id = (self.next_reply_id or 0) + 1",
    "    local id = tostring(self.next_reply_id)",
    "    self.reply_jobs[id] = {",
    "        msg = self:reply_context(msg),",
    "        body = body",
    "    }",
    "    mesh.timer.after(self:random_reply_delay(), { name = \"weatherbot_reply:\" .. id })",
    "end",
    "",
    "function Bot:send_delayed_reply(name)",
    "    local id = string.match(tostring(name or \"\"), \"^weatherbot_reply:(%d+)$\")",
    "    if not id then return end",
    "    self.reply_jobs = self.reply_jobs or {}",
    "    local job = self.reply_jobs[id]",
    "    self.reply_jobs[id] = nil",
    "    if job then self:send_reply(job.msg, job.body) end",
    "end",
    "",
    "function Bot:scope(msg)",
    "    return tostring(msg.chat_type or \"chat\") .. \":\" .. tostring(msg.chat_key or \"\")",
    "end",
    "",
    "function Bot:jget(key)",
    "    local raw = mesh.kv.get(key)",
    "    if not raw or raw == \"\" then return nil end",
    "    local value, err = mesh.json.try_decode(raw)",
    "    if not value then",
    "        mesh.log(\"WeatherBot cache decode failed: \" .. tostring(err))",
    "    end",
    "    return value",
    "end",
    "",
    "function Bot:jset(key, value)",
    "    mesh.kv.set(key, mesh.json.encode(value))",
    "end",
    "",
    "-- Cooldown нужен, чтобы бот не забивал радиоэфир повторными ответами.",
    "function Bot:cooldown_hit(msg)",
    "    local key = \"cooldown:\" .. self:scope(msg)",
    "    local now = mesh.now()",
    "    local last = tonumber(mesh.kv.get(key) or \"0\") or 0",
    "    if now - last < self.cooldown then return true end",
    "    mesh.kv.set(key, tostring(math.floor(now)))",
    "    return false",
    "end",
    "",
    "-- Возвращает текст после команды. Например, \"@weather Казань\" -> \"Казань\".",
    "function Bot:command_tail(text)",
    "    local raw = trim(text)",
    "    local head, tail = word(raw)",
    "    local lowered = low(head)",
    "    local mixed_lowered = command_key(head)",
    "    for _, command in ipairs(self.commands or {}) do",
    "        local normalized = low(command)",
    "        if lowered == normalized or (normalized == \"@погода\" and mixed_lowered == normalized) then return trim(tail) end",
    "    end",
    "    return nil",
    "end",
    "",
    "-- Разбор подкоманд. Основной сценарий: пусто = дефолтный город, иначе текст считается городом.",
    "function Bot:parse(args)",
    "    local head, tail = word(args)",
    "    local key = low(head)",
    "    local modes = {",
    "        help = \"help\", h = \"help\", [\"?\"] = \"help\",",
    "        [\"3d\"] = \"3d\", [\"3д\"] = \"3d\", forecast = \"3d\",",
    "        rain = \"rain\", [\"дождь\"] = \"rain\",",
    "        wind = \"wind\", [\"ветер\"] = \"wind\",",
    "        risk = \"risk\", [\"риск\"] = \"risk\",",
    "        node = \"node\", [\"нода\"] = \"node\",",
    "        here = \"here\", [\"тут\"] = \"here\"",
    "    }",
    "    local mode = modes[key]",
    "    if mode then return mode, tail end",
    "    if key == \"set\" then return \"config_only\", tail end",
    "    return \"current\", args",
    "end",
    "",
    "function Bot:city_queries(name)",
    "    local queries, seen = {}, {}",
    "    local function add(value)",
    "        local text = trim(value)",
    "        if text == \"\" then return end",
    "        local key = low(text)",
    "        if seen[key] then return end",
    "        seen[key] = true",
    "        queries[#queries + 1] = text",
    "    end",
    "",
    "    add(name)",
    "    add(self.city_aliases and self.city_aliases[city_key(name)])",
    "",
    "    local latin = translit_ru(name)",
    "    if city_key(latin) ~= city_key(name) then add(latin) end",
    "    return queries",
    "end",
    "",
    "-- Геокодинг города через Open-Meteo. Если кириллица не нашлась, пробуем латинский fallback.",
    "function Bot:city(query)",
    "    local name = trim(query)",
    "    if name == \"\" then return nil, \"Укажите город: @weather Москва\" end",
    "",
    "    local key = \"geo:\" .. low(name)",
    "    local cached = self:jget(key)",
    "    if cached and cached.ts and cached.location and mesh.now() - tonumber(cached.ts) < self.geo_cache_seconds then",
    "        return cached.location, nil",
    "    end",
    "",
    "    local http_error, decode_error, coord_error, had_response = nil, nil, nil, false",
    "    for _, search in ipairs(self:city_queries(name)) do",
    "        local url = \"https://geocoding-api.meteo.privatepractice.app/v1/search?name=\" .. enc(search)",
    "            .. \"&count=1&language=ru&format=json\"",
    "        local response = mesh.curl.get(url, {",
    "            timeout_ms = 700,",
    "            max_bytes = 20000,",
    "            headers = { [\"Accept\"] = \"application/json\" }",
    "        })",
    "",
    "        if not response.ok then",
    "            http_error = \"Геокодинг недоступен: HTTP \" .. tostring(response.status)",
    "        else",
    "            local data, err = mesh.json.try_decode(response.body)",
    "            if not data then",
    "                decode_error = \"Ошибка геокодинга: \" .. tostring(err)",
    "            else",
    "                had_response = true",
    "                local hit = data.results and data.results[1]",
    "                if hit then",
    "                    local country = tostring(hit.country_code or hit.country or \"\")",
    "                    local loc = {",
    "                        kind = \"city\",",
    "                        query = name,",
    "                        name = tostring(hit.name or name) .. (country ~= \"\" and (\" \" .. country) or \"\"),",
    "                        lat = tonumber(hit.latitude),",
    "                        lon = tonumber(hit.longitude)",
    "                    }",
    "                    if loc.lat and loc.lon then",
    "                        self:jset(key, { ts = mesh.now(), location = loc })",
    "                        return loc, nil",
    "                    end",
    "                    coord_error = \"У города нет координат: \" .. name",
    "                end",
    "            end",
    "        end",
    "    end",
    "",
    "    if cached and cached.location and http_error and not had_response then return cached.location, nil end",
    "    if http_error and not had_response then return nil, http_error end",
    "    if decode_error and not had_response then return nil, decode_error end",
    "    if coord_error then return nil, coord_error end",
    "    return nil, \"Город не найден: \" .. name",
    "end",
    "",
    "function Bot:node_label(node)",
    "    return node.long_name or node.short_name or node.node_id or tostring(node.node_num or \"node\")",
    "end",
    "",
    "-- Поиск ноды по имени/ID. Используется для \"@weather node Alpha\".",
    "function Bot:node(query)",
    "    local needle = low(trim(query))",
    "    if needle == \"\" then return nil, \"Укажите ноду: @weather node Alpha\" end",
    "",
    "    for _, node in ipairs(mesh.chat.nodes()) do",
    "        local fields = {",
    "            node.node_id,",
    "            node.long_name,",
    "            node.short_name,",
    "            tostring(node.node_num or \"\")",
    "        }",
    "        for _, field in ipairs(fields) do",
    "            local value = low(field or \"\")",
    "            if value == needle or string.find(value, needle, 1, true) then",
    "                local lat, lon = tonumber(node.latitude), tonumber(node.longitude)",
    "                if not lat or not lon or (lat == 0 and lon == 0) then",
    "                    return nil, \"У ноды нет координат: \" .. self:node_label(node)",
    "                end",
    "                return { kind = \"node\", name = self:node_label(node), lat = lat, lon = lon }, nil",
    "            end",
    "        end",
    "    end",
    "    return nil, \"Нода не найдена: \" .. trim(query)",
    "end",
    "",
    "function Bot:here()",
    "    local owner = mesh.owner()",
    "    if not owner or not owner.node_id then return nil, \"Своя нода неизвестна\" end",
    "    return self:node(owner.node_id)",
    "end",
    "",
    "-- Дефолтная локация берётся из Bot.default_place, а не из пользовательского ввода.",
    "function Bot:default_location()",
    "    local configured = self.default_place or {}",
    "    local lat, lon = tonumber(configured.lat), tonumber(configured.lon)",
    "    if lat and lon then",
    "        return {",
    "            kind = \"default\",",
    "            name = tostring(configured.name or configured.query or \"default\"),",
    "            lat = lat,",
    "            lon = lon",
    "        }, nil",
    "    end",
    "    return self:city(configured.query or configured.name or \"\")",
    "end",
    "",
    "-- URL прогноза. Берём только поля, которые реально нужны для коротких ответов.",
    "function Bot:weather_url(loc)",
    "    return \"https://api.meteo.privatepractice.app/v1/forecast\"",
    "        .. \"?latitude=\" .. tostring(loc.lat)",
    "        .. \"&longitude=\" .. tostring(loc.lon)",
    "        .. \"&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,rain,showers,snowfall,weather_code,surface_pressure,wind_speed_10m,wind_direction_10m,wind_gusts_10m\"",
    "        .. \"&hourly=precipitation_probability,weather_code,temperature_2m,wind_speed_10m\"",
    "        .. \"&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max,wind_gusts_10m_max\"",
    "        .. \"&forecast_days=3&timezone=auto&wind_speed_unit=ms&precipitation_unit=mm\"",
    "end",
    "",
    "function Bot:decode_weather(body)",
    "    local data, err = mesh.json.try_decode(body or \"\")",
    "    if not data then return nil, \"JSON прогноза не прочитан: \" .. tostring(err) end",
    "    return data, nil",
    "end",
    "",
    "-- Получение прогноза. Сначала проверяем свежий кэш, потом HTTP, затем stale-кэш.",
    "function Bot:weather(loc)",
    "    local key = string.format(\"forecast:%.4f:%.4f\", tonumber(loc.lat), tonumber(loc.lon))",
    "    local now = mesh.now()",
    "    local cached = self:jget(key)",
    "",
    "    if cached and cached.ts and cached.body and now - tonumber(cached.ts) < self.forecast_cache_seconds then",
    "        return self:decode_weather(cached.body)",
    "    end",
    "",
    "    local response = mesh.curl.get(self:weather_url(loc), {",
    "        timeout_ms = 800,",
    "        max_bytes = 90000,",
    "        headers = { [\"Accept\"] = \"application/json\" }",
    "    })",
    "    if response.ok then",
    "        self:jset(key, { ts = now, body = response.body })",
    "        return self:decode_weather(response.body)",
    "    end",
    "",
    "    if cached and cached.ts and cached.body and now - tonumber(cached.ts) < self.stale_cache_seconds then",
    "        local data, err = self:decode_weather(cached.body)",
    "        if data then return data, nil, tonumber(cached.ts) end",
    "        return nil, err",
    "    end",
    "    return nil, response.error and (\"Погода недоступна: \" .. response.error)",
    "        or (\"Погода недоступна: HTTP \" .. tostring(response.status))",
    "end",
    "",
    "function Bot:rain12(data)",
    "    local hourly = data.hourly or {}",
    "    local times = hourly.time or {}",
    "    local probs = hourly.precipitation_probability or {}",
    "    local current_time = data.current and data.current.time or times[1] or \"\"",
    "    local start_at = 1",
    "    for i = 1, #times do",
    "        if tostring(times[i]) >= tostring(current_time) then",
    "            start_at = i",
    "            break",
    "        end",
    "    end",
    "",
    "    local peak, peak_time = nil, nil",
    "    for i = start_at, math.min(#times, start_at + 11) do",
    "        local p = tonumber(probs[i])",
    "        if p and (not peak or p > peak) then",
    "            peak, peak_time = p, tostring(times[i] or \"\")",
    "        end",
    "    end",
    "    if peak_time and #peak_time >= 16 then peak_time = string.sub(peak_time, 12, 16) end",
    "    return peak, peak_time",
    "end",
    "",
    "-- Практическая оценка риска: осадки, ветер, жара/мороз, гроза.",
    "function Bot:risk(data)",
    "    local current, daily = data.current or {}, data.daily or {}",
    "    local code = current.weather_code or (daily.weather_code and daily.weather_code[1])",
    "    local rain_peak = maxn(self:rain12(data), daily.precipitation_probability_max and daily.precipitation_probability_max[1])",
    "    local wind_peak = maxn(",
    "        current.wind_gusts_10m,",
    "        current.wind_speed_10m,",
    "        daily.wind_gusts_10m_max and daily.wind_gusts_10m_max[1],",
    "        daily.wind_speed_10m_max and daily.wind_speed_10m_max[1]",
    "    )",
    "    local tmax = daily.temperature_2m_max and tonumber(daily.temperature_2m_max[1])",
    "    local tmin = daily.temperature_2m_min and tonumber(daily.temperature_2m_min[1])",
    "    local risks = {}",
    "    local function add(text) risks[#risks + 1] = text end",
    "",
    "    if is_thunder(code) then add(\"гроза\") end",
    "    if is_snow(code) then add(\"снег\") end",
    "    if rain_peak and rain_peak >= 70 then add(\"дождь \" .. pct(rain_peak) .. \"%\")",
    "    elseif rain_peak and rain_peak >= 50 then add(\"возможен дождь \" .. pct(rain_peak) .. \"%\") end",
    "    if wind_peak and wind_peak >= 15 then add(\"сильный ветер до \" .. num(wind_peak) .. \" м/с\")",
    "    elseif wind_peak and wind_peak >= 10 then add(\"ветер до \" .. num(wind_peak) .. \" м/с\") end",
    "    if tmax and tmax >= 30 then add(\"жара \" .. signed(tmax) .. \" C\") end",
    "    if tmin and tmin <= -10 then add(\"мороз \" .. signed(tmin) .. \" C\") end",
    "",
    "    return #risks > 0 and table.concat(risks, \", \") or \"нет заметных рисков\"",
    "end",
    "",
    "-- Формирование коротких ответов для радиоэфира.",
    "function Bot:format(mode, loc, data)",
    "    local current, daily = data.current or {}, data.daily or {}",
    "",
    "    local formats = {}",
    "",
    "    formats.current = function()",
    "        local rain_peak = maxn(self:rain12(data), daily.precipitation_probability_max and daily.precipitation_probability_max[1])",
    "        local pressure = tonumber(current.surface_pressure)",
    "        local pressure_text = pressure and (\", \" .. num(pressure * 0.750062) .. \" мм\") or \"\"",
    "        return string.format(",
    "            \"%s: %s C, ощущ. %s, %s. Ветер %s м/с, дождь %s%%%s. Сегодня %s..%s; риск: %s.\",",
    "            loc.name,",
    "            signed(current.temperature_2m),",
    "            signed(current.apparent_temperature),",
    "            weather_name(current.weather_code),",
    "            num(current.wind_speed_10m),",
    "            pct(rain_peak),",
    "            pressure_text,",
    "            signed(daily.temperature_2m_min and daily.temperature_2m_min[1]),",
    "            signed(daily.temperature_2m_max and daily.temperature_2m_max[1]),",
    "            self:risk(data)",
    "        )",
    "    end",
    "",
    "    formats[\"3d\"] = function()",
    "        local dates, parts = daily.time or {}, {}",
    "        for i = 1, math.min(3, #dates) do",
    "            local label = i == 1 and \"сег\" or (i == 2 and \"зав\" or string.sub(tostring(dates[i]), 6, 10))",
    "            parts[#parts + 1] = string.format(",
    "                \"%s %s..%s %s %s%%\",",
    "                label,",
    "                signed(daily.temperature_2m_min and daily.temperature_2m_min[i]),",
    "                signed(daily.temperature_2m_max and daily.temperature_2m_max[i]),",
    "                weather_short(daily.weather_code and daily.weather_code[i]),",
    "                pct(daily.precipitation_probability_max and daily.precipitation_probability_max[i])",
    "            )",
    "        end",
    "        return #parts > 0 and (loc.name .. \" 3д: \" .. table.concat(parts, \"; \") .. \".\")",
    "            or (loc.name .. \": прогноз на 3 дня недоступен.\")",
    "    end",
    "",
    "    formats.rain = function()",
    "        local peak, at = self:rain12(data)",
    "        local now_mm = maxn(current.precipitation, current.rain, current.showers, current.snowfall) or 0",
    "        return string.format(",
    "            \"%s дождь: 12ч макс %s%%%s, сегодня до %s%%, сейчас %.1f мм.\",",
    "            loc.name,",
    "            pct(peak),",
    "            at and (\" пик \" .. at) or \"\",",
    "            pct(daily.precipitation_probability_max and daily.precipitation_probability_max[1]),",
    "            tonumber(now_mm) or 0",
    "        )",
    "    end",
    "",
    "    formats.wind = function()",
    "        local gust = maxn(current.wind_gusts_10m, daily.wind_gusts_10m_max and daily.wind_gusts_10m_max[1])",
    "        return string.format(",
    "            \"%s ветер: сейчас %s м/с, порывы %s м/с, максимум сегодня %s м/с. Риск: %s.\",",
    "            loc.name,",
    "            num(current.wind_speed_10m),",
    "            num(gust),",
    "            num(daily.wind_speed_10m_max and daily.wind_speed_10m_max[1]),",
    "            self:risk(data)",
    "        )",
    "    end",
    "",
    "    formats.risk = function()",
    "        return loc.name .. \" риск: \" .. self:risk(data) .. \".\"",
    "    end",
    "",
    "    return (formats[mode] or formats.current)()",
    "end",
    "",
    "function Bot:location_for(mode, query, msg)",
    "    local loc, err",
    "    if mode == \"node\" then",
    "        loc, err = self:node(query)",
    "        return loc, loc and \"current\" or err",
    "    end",
    "    if mode == \"here\" then",
    "        loc, err = self:here()",
    "        return loc, loc and \"current\" or err",
    "    end",
    "    if trim(query) == \"\" then",
    "        loc, err = self:default_location()",
    "        return loc, loc and mode or err",
    "    end",
    "    loc, err = self:city(query)",
    "    return loc, loc and mode or err",
    "end",
    "",
    "function Bot:help()",
    "    return \"WeatherBot: @weather, @weather <город>, 3d <город>, rain/дождь <город>, wind/ветер <город>, risk/риск <город>, node <имя>, here/тут, clear.\"",
    "end",
    "",
    "-- Служебная команда для отладки и принудительного обновления данных.",
    "function Bot:clear_cache()",
    "    local count = 0",
    "    for key, _ in pairs(mesh.kv.list()) do",
    "        if string.sub(key, 1, 4) == \"geo:\" or string.sub(key, 1, 9) == \"forecast:\" then",
    "            if mesh.kv.delete(key) then count = count + 1 end",
    "        end",
    "    end",
    "    return count",
    "end",
    "",
    "-- Сохраняем только поля сообщения, нужные для ответа после асинхронного timer-шагa.",
    "function Bot:reply_context(msg)",
    "    return {",
    "        packet_id = msg.packet_id,",
    "        chat_type = msg.chat_type,",
    "        chat_key = msg.chat_key,",
    "        channel = msg.channel,",
    "        from = msg.from,",
    "        to = msg.to",
    "    }",
    "end",
    "",
    "-- Очередь нужна, чтобы HTTP не выполнялся внутри on_message и не превышал лимит callback.",
    "function Bot:schedule()",
    "    if self.timer_pending then return end",
    "    self.timer_pending = true",
    "    mesh.timer.after(0.1, { name = \"weatherbot\" })",
    "end",
    "",
    "function Bot:enqueue(msg, mode, query)",
    "    self.jobs = self.jobs or {}",
    "    self.next_job_id = (self.next_job_id or 0) + 1",
    "    self.jobs[#self.jobs + 1] = {",
    "        id = self.next_job_id,",
    "        msg = self:reply_context(msg),",
    "        mode = mode,",
    "        query = query,",
    "        step = \"resolve\"",
    "    }",
    "    self:schedule()",
    "end",
    "",
    "function Bot:process(job)",
    "    if job.step == \"resolve\" then",
    "        local loc, mode_or_err = self:location_for(job.mode, job.query, job.msg)",
    "        if not loc then return self:reply(job.msg, mode_or_err) end",
    "        job.location = loc",
    "        job.forecast_mode = mode_or_err",
    "        job.step = \"forecast\"",
    "        self.jobs[#self.jobs + 1] = job",
    "        return",
    "    end",
    "",
    "    local data, err, stale_ts = self:weather(job.location)",
    "    if not data then return self:reply(job.msg, err) end",
    "",
    "    local text = self:format(job.forecast_mode, job.location, data)",
    "    if stale_ts then text = \"[кэш \" .. mesh.iso_time(stale_ts) .. \"] \" .. text end",
    "    self:reply(job.msg, text)",
    "end",
    "",
    "function Bot:tick()",
    "    self.timer_pending = false",
    "    self.jobs = self.jobs or {}",
    "    local job = table.remove(self.jobs, 1)",
    "    if not job then return end",
    "",
    "    self:process(job)",
    "",
    "    if #self.jobs > 0 then self:schedule() end",
    "end",
    "",
    "function Bot:handle(msg, args)",
    "    if low(trim(args)) == \"clear\" then",
    "        return self:reply(msg, \"WeatherBot: кэш очищен, ключей: \" .. tostring(self:clear_cache()))",
    "    end",
    "",
    "    local mode, query = self:parse(args)",
    "    if mode == \"help\" then return self:reply(msg, self:help()) end",
    "    if mode == \"config_only\" then",
    "        return self:reply(msg, \"Город по умолчанию задаётся в коде: Bot.default_place.\")",
    "    end",
    "    if self:cooldown_hit(msg) then return end",
    "    self:enqueue(msg, mode, query)",
    "end",
    "",
    "function on_message(msg)",
    "    if msg.system or not msg.text then return end",
    "    local args = Bot:command_tail(msg.text)",
    "    if not args then return end",
    "",
    "    Bot:handle(msg, args)",
    "end",
    "",
    "function on_timer(event)",
    "    if event.name == \"weatherbot\" then",
    "        Bot:tick()",
    "    elseif string.match(tostring(event.name or \"\"), \"^weatherbot_reply:\") then",
    "        Bot:send_delayed_reply(event.name)",
    "    end",
    "end"
  ],
  "botType": "AIR_BOT",
  "automationName": ""
}
